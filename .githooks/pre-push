#!/usr/bin/env bash
# Data policy check on every commit about to be pushed: catches commits made with --no-verify, on another
# machine or before the hooks were enabled. Scans paths, blob sizes, added lines and commit messages.
set -uo pipefail
. "$(git rev-parse --show-toplevel)/.githooks/rules.sh"
zero=0000000000000000000000000000000000000000
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                      # branch deletion
  if [ "$remote_sha" = "$zero" ]; then range=("$local_sha" --not --remotes); else range=("$remote_sha..$local_sha"); fi
  # if the remote tip is unknown locally (not fetched yet), fall back to everything not on any remote
  commits=$(git rev-list "${range[@]}" 2>/dev/null) || commits=$(git rev-list "$local_sha" --not --remotes)
  [ -z "$commits" ] && continue
  for c in $commits; do
    while IFS= read -r -d '' f; do
      check_path "$f" "$(git cat-file -s "$c:$f" 2>/dev/null || echo 0)" || fail=1
    done < <(git diff-tree --root --no-commit-id -r --name-only --diff-filter=ACMR -z "$c")
    git show -U0 --no-color --no-ext-diff --format= --diff-filter=ACMR "$c" | added_lines | check_text "commit ${c:0:7}" || fail=1
    git log -1 --format=%B "$c" | check_text "message of ${c:0:7}" || fail=1
  done
done
[ $fail -eq 0 ] || blocked_msg
exit $fail
