#!/usr/bin/env bash
# Data policy check on the staged changes (see rules.sh and README, "Data policy").
set -uo pipefail
. "$(git rev-parse --show-toplevel)/.githooks/rules.sh"
fail=0
while IFS= read -r -d '' f; do
  check_path "$f" "$(git cat-file -s ":$f" 2>/dev/null || echo 0)" || fail=1
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
git diff --cached -U0 --no-color --no-ext-diff --diff-filter=ACMR | added_lines | check_text "staged changes" || fail=1
[ $fail -eq 0 ] || blocked_msg
exit $fail
